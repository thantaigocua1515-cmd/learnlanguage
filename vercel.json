{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/vocab/:lemma/examples",
      "destination": "/api/vocab.js?lemma=:lemma&type=examples"
    },
    {
      "source": "/api/vocab/:lemma",
      "destination": "/api/vocab.js?lemma=:lemma"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}

